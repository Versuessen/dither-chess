{
  "name": "dither",
  "version": "0.1.0",
  "private": true,
  "description": "Offline chess practice against human-like neural bots.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:static": "playwright test -c playwright.static.config.ts",
    "art": "node tools/art/render.ts",
    "tauri": "tauri",
    "art:pieces": "node tools/art/pieces1bit.ts",
    "openings": "node tools/openings/build.ts",
    "models:fetch": "node tools/packs/fetch.ts",
    "models:pack": "cd tools/models && uv run dither-models pack",
    "models:all": "cd tools/models && uv run dither-models all"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-sql": "2.6.0",
    "chess.js": "1.4.0",
    "chessground": "9.2.1",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
